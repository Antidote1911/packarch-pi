<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <vendor>packarch-pi</vendor>
  <vendor_url>https://github.com/packarch/packarch-pi</vendor_url>

  <action id="org.packarch.packarch-pi.pkexec.policy.run">
    <description>Lancer le programme</description>
    <message>Une authentification est nécessaire pour lancer l’application</message>
    <icon_name>packarch-pi</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/packarch-pi</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
